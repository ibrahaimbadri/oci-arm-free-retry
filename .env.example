# =============================================================================
# Oracle Cloud Infrastructure (OCI) - Configuration Template
# Copy this file to .env and fill in your details:
#   cp .env.example .env
# =============================================================================

# OCI CLI Config File Location & Profile
OCI_CONFIG_PATH=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Compartment OCID (Leave as tenancy OCID if using the default root compartment)
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Subnet OCID (Public subnet in your VCN)
OCI_SUBNET_ID=ocid1.subnet.oc1.<region>.aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OS Image OCID (ARM / aarch64 image for your specific region, e.g. Ubuntu or Oracle Linux)
OCI_IMAGE_ID=ocid1.image.oc1.<region>.aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SSH Public Key: Either a path to your .pub file OR the raw key string
OCI_SSH_PUBLIC_KEY=~/.ssh/id_rsa.pub

# Instance Sizing:
# Total Always Free A1 Flex limit: 2 OCPUs, 12 GB RAM, 200 GB storage.
# Defaults are set to half of the total limit (1 OCPU, 6 GB RAM, 100 GB storage):
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=1.0
OCI_MEMORY_IN_GBS=6.0
OCI_BOOT_VOLUME_GB=100
OCI_DISPLAY_NAME=free-a1-flex-instance

# Polling Interval (in seconds) between retry attempts
OCI_RETRY_INTERVAL=30
